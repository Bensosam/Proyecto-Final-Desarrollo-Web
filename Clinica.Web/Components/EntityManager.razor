    private async Task UpdateEvolutionMinimumDateAsync(
        string idTratamiento)
    {
        _evolutionMinDateTime =
            string.Empty;

        if (!int.TryParse(
                idTratamiento,
                out var tratamientoId))
        {
            return;
        }

        var tratamientos =
            await Api.GetCollectionAsync(
                "api/Tratamientos");

        var tratamiento =
            tratamientos.FirstOrDefault(t =>
                ApiClient.GetDisplayValue(
                    t,
                    "idTratamiento")
                == tratamientoId.ToString());

        if (tratamiento.ValueKind !=
            JsonValueKind.Object)
        {
            return;
        }

        var fechaFinRaw =
            ApiClient.GetDisplayValue(
                tratamiento,
                "fechaFin");

        if (!DateTime.TryParse(
                fechaFinRaw,
                out var fechaFin))
        {
            return;
        }

        _evolutionMinDateTime =
            fechaFin.Date.ToString(
                "yyyy-MM-ddT00:00");

        var fechaActual =
            GetValue("fecha");

        if (!DateTime.TryParse(
                fechaActual,
                out var fechaSeleccionada) ||
            fechaSeleccionada.Date <
            fechaFin.Date)
        {
            _formValues["fecha"] =
                _evolutionMinDateTime;
        }
    }
    private async Task SaveAsync()
    {
        if (Definition is null)
        {
            return;
        }

        _editorError = null;

        foreach (var field in VisibleFields
            .Where(f =>
                f.Required &&
                f.Kind != FieldKind.Boolean))
        {
            if (string.IsNullOrWhiteSpace(
                GetValue(field.Key)))
            {
                _editorError =
                    $"El campo {field.Label} es obligatorio.";

                return;
            }
        }

        _saving = true;

        try
        {
            var payload =
                BuildPayload();

            ApiResponse response;

            if (_editing &&
                _selected is { } selected)
            {
                var id =
                    ApiClient.GetDisplayValue(
                        selected,
                        Definition.IdField);

                payload[Definition.IdField] =
                    int.TryParse(
                        id,
                        out var parsedId)
                        ? parsedId
                        : id;

                response =
                    await Api.PutAsync(
                        $"{Definition.Endpoint}/{id}",
                        payload);
            }
            else
            {
                response =
                    await Api.PostAsync(
                        Definition.Endpoint,
                        payload);
            }

            if (!response.IsSuccess)
            {
                _editorError =
                    response.Message
                    ?? "No fue posible guardar el registro.";

                return;
            }
            if (!_editing &&
                Definition.Slug.Equals(
                    "pacientes",
                    StringComparison.OrdinalIgnoreCase) &&
                response.Data is { } created &&
                ApiClient.TryGetProperty(
                    created,
                    "idPaciente",
                    out var idPacienteElement) &&
                idPacienteElement.TryGetInt32(
                    out var idPacienteNuevo))
            {
                _showEditor = false;

                Navigation.NavigateTo(
                    $"/modulo/historial-medico?paciente={idPacienteNuevo}");

                return;
            }


            _showEditor = false;

            _messageIsError = false;

            _message =
                _editing
                    ? "Cambios guardados correctamente."
                    : "Registro creado correctamente.";

            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private Dictionary<string, object?>
        BuildPayload()
    {
        var payload =
            new Dictionary<string, object?>(
                StringComparer.OrdinalIgnoreCase);

        if (Definition is null)
        {
            return payload;
        }

        foreach (var field in VisibleFields)
        {
            if (
                field.Key.Equals(
                    "idPaciente",
                    StringComparison.OrdinalIgnoreCase) &&
                (
                    Definition.Slug.Equals(
                        "diagnosticos",
                        StringComparison.OrdinalIgnoreCase) ||
                    Definition.Slug.Equals(
                        "examenes",
                        StringComparison.OrdinalIgnoreCase) ||
                    Definition.Slug.Equals(
                        "recetas",
                        StringComparison.OrdinalIgnoreCase) ||
                    Definition.Slug.Equals(
                        "tratamientos",
                        StringComparison.OrdinalIgnoreCase) ||
                    Definition.Slug.Equals(
                        "evoluciones",
                        StringComparison.OrdinalIgnoreCase)
                ))
            {
                continue;
            }

            var raw =
                GetValue(field.Key).Trim();

if (Definition.Slug.Equals(
        "consultas",
        StringComparison.OrdinalIgnoreCase) &&
    field.Key.Equals(
        "lecturaResultadosExamenes",
        StringComparison.OrdinalIgnoreCase))
{
    payload[field.Key] =
        raw.Equals(
            "Sí",
            StringComparison.OrdinalIgnoreCase);

    continue;
}

            object? value =
                field.Kind switch
                {
                    FieldKind.Boolean =>
                        bool.TryParse(
                            raw,
                            out var b)
                        && b,

                    FieldKind.Integer =>
                        int.TryParse(
                            raw,
                            out var i)
                            ? i
                            : 0,

                    FieldKind.Decimal =>
                        decimal.TryParse(
                            raw,
                            NumberStyles.Any,
                            CultureInfo.InvariantCulture,
                            out var d)
                            ? d
                            : 0m,

                    FieldKind.Select =>
                        ParseSelectValue(raw),

                    _ =>
                        string.IsNullOrWhiteSpace(raw)
                            ? null
                            : raw
                };

            payload[field.Key] =
                value;
        }
if (Definition.Slug.Equals(
        "examenes",
        StringComparison.OrdinalIgnoreCase) &&
    !string.IsNullOrWhiteSpace(
        _examPdfBase64))
{
    payload["archivoPdfBase64"] =
        _examPdfBase64;

    payload["nombreArchivoPdf"] =
        _examPdfName;
}

        return payload;
    }

    private static object?
        ParseSelectValue(
            string raw)
    {
        if (string.IsNullOrWhiteSpace(
            raw))
        {
            return null;
        }

        return int.TryParse(
            raw,
            out var id)
            ? id
            : raw;
    }

