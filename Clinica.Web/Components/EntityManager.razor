    private static string FormatDetailItemValue(
        JsonElement record,
        DetailItem item)
    {
        var raw =
            ApiClient.GetDisplayValue(
                record,
                item.Key);

        if (raw == "—")
        {
            return raw;
        }

        return item.Format switch
        {
            DetailFormat.Date
                when DateTime.TryParse(
                    raw,
                    out var fecha) =>
                fecha.ToString(
                    "dd/MM/yyyy"),

            DetailFormat.DateTime
                when DateTime.TryParse(
                    raw,
                    out var fechaHora) =>
                fechaHora.ToString(
                    "dd/MM/yyyy HH:mm"),

            DetailFormat.Currency
                when decimal.TryParse(
                    raw,
                    NumberStyles.Any,
                    CultureInfo.InvariantCulture,
                    out var dinero) =>
                $"Q {dinero:N2}",

            DetailFormat.Status =>
                raw.Equals(
                    "true",
                    StringComparison.OrdinalIgnoreCase) ||
                raw.Equals(
                    "sí",
                    StringComparison.OrdinalIgnoreCase)
                    ? "Activo"
                    : "Inactivo",

            DetailFormat.YesNo =>
                raw.Equals(
                    "true",
                    StringComparison.OrdinalIgnoreCase) ||
                raw.Equals(
                    "sí",
                    StringComparison.OrdinalIgnoreCase)
                    ? "Sí"
                    : "No",

            _ => raw
        };
    }

