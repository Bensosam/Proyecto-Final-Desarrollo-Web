    private async Task LoadPatientConsultasAsync(
        string idPaciente)
    {
        var options =
            new List<SelectOption>();

        if (!int.TryParse(
                idPaciente,
                out var pacienteId))
        {
            _options["idConsulta"] =
                options;

            return;
        }

        var consultas =
            await Api.GetCollectionAsync(
                "api/Consultas");

        foreach (var consulta in consultas)
        {
            var pacienteRaw =
                ApiClient.GetDisplayValue(
                    consulta,
                    "idPaciente");

            if (!int.TryParse(
                    pacienteRaw,
                    out var pacienteConsultaId) ||
                pacienteConsultaId != pacienteId)
            {
                continue;
            }

            var idConsulta =
                ApiClient.GetDisplayValue(
                    consulta,
                    "idConsulta");

            var numero =
                ApiClient.GetDisplayValue(
                    consulta,
                    "numeroConsultaPaciente");

            var motivo =
                ApiClient.GetDisplayValue(
                    consulta,
                    "motivo");

            var fechaRaw =
                ApiClient.GetDisplayValue(
                    consulta,
                    "fechaConsulta");

            var texto =
                $"Consulta #{numero} - {motivo}";

            if (DateTime.TryParse(
                    fechaRaw,
                    out var fecha))
            {
                texto =
                    $"Consulta #{numero} - " +
                    $"{fecha:dd/MM/yyyy HH:mm} - " +
                    motivo;
            }

            options.Add(
                new SelectOption
                {
                    Value = idConsulta,
                    Text = texto
                });
        }

        _options["idConsulta"] =
            options;
    }

