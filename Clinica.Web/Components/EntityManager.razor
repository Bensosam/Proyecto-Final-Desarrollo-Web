    private void AskDelete(
        JsonElement record)
    {
        _selected = record;
        _showDelete = true;
    }

    private async Task DeleteAsync()
    {
        if (Definition is null ||
            _selected is null)
        {
            return;
        }

        _saving = true;

        try
        {
            var id =
                ApiClient.GetDisplayValue(
                    _selected.Value,
                    Definition.IdField);

            var response =
                await Api.DeleteAsync(
                    $"{Definition.Endpoint}/{id}");

            if (!response.IsSuccess)
            {
                _showDelete = false;

                _messageIsError = true;

                _message =
                    response.Message
                    ?? "No fue posible eliminar el registro.";

                return;
            }

            _showDelete = false;

            _messageIsError = false;

            _message =
                "Registro eliminado correctamente.";

            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private string FormatValue(
        JsonElement record,
        ColumnDefinition column)
    {
        var raw =
            ApiClient.GetDisplayValue(
                record,
                column.Key);

        if (raw == "—")
        {
            return raw;
        }

        return column.Format switch
        {
            ColumnFormat.Currency
                when decimal.TryParse(
                    raw,
                    NumberStyles.Any,
                    CultureInfo.InvariantCulture,
                    out var money) =>
                $"Q {money:N2}",

            ColumnFormat.Date
                when DateTime.TryParse(
                    raw,
                    out var date) =>
                date.ToString(
                    "dd/MM/yyyy"),

            ColumnFormat.DateTime
                when DateTime.TryParse(
                    raw,
                    out var dateTime) =>
                dateTime.ToString(
                    "dd/MM/yyyy HH:mm"),

            ColumnFormat.Boolean =>
                raw.Equals(
                    "true",
                    StringComparison.OrdinalIgnoreCase)
                || raw == "Sí"
                    ? "Activo"
                    : "Inactivo",

            _ => raw
        };
    }

    private static string StatusClass(
        string value)
    {
        var normalized =
            value
                .Trim()
                .ToLowerInvariant();

        if (normalized == "false" ||
            normalized == "no" ||
            normalized.Contains("inactiv") ||
            normalized.Contains("anulad") ||
            normalized.Contains("salida"))
        {
            return "status-danger";
        }

        if (normalized == "true" ||
            normalized == "sí" ||
            normalized.Contains("activ") ||
            normalized.Contains("libre") ||
            normalized.Contains("pagada") ||
            normalized.Contains("entrada"))
        {
            return "status-success";
        }

        if (normalized.Contains("limpieza") ||
            normalized.Contains("emitida") ||
            normalized.Contains("pendiente") ||
            normalized.Contains("ajuste"))
        {
            return "status-warning";
        }

        if (normalized.Contains("ocupada") ||
            normalized.Contains("finalizada"))
        {
            return "status-info";
        }

        return "status-neutral";
    }

    private static string NormalizeInput(
        JsonElement value,
        FieldKind kind)
    {
        if (value.ValueKind is
            JsonValueKind.Null or
            JsonValueKind.Undefined)
        {
            return string.Empty;
        }

        if (kind == FieldKind.Boolean)
        {
            return value.ValueKind ==
                   JsonValueKind.True
                ? "true"
                : value.ValueKind ==
                  JsonValueKind.False
                    ? "false"
                    : value
                        .ToString()
                        .ToLowerInvariant();
        }

        var raw =
            value.ValueKind ==
            JsonValueKind.String
                ? value.GetString()
                  ?? string.Empty
                : value.ToString();

        if (kind ==
                FieldKind.DateTime &&
            DateTime.TryParse(
                raw,
                out var dateTime))
        {
            return dateTime.ToString(
                "yyyy-MM-ddTHH:mm");
        }

        if (kind ==
                FieldKind.Date &&
            DateTime.TryParse(
                raw,
                out var date))
        {
            return date.ToString(
                "yyyy-MM-dd");
        }

        if (kind ==
                FieldKind.Time &&
            TimeSpan.TryParse(
                raw,
                out var time))
        {
            return time.ToString(
                @"hh\:mm\:ss");
        }

        return raw;
    }

