@inject ApiClient Api
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject TokenStorageService TokenStorage
@inject IJSRuntime JS
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@if (Definition is null)
{
    <div class="empty-state">
        <AppIcon Name="grid" />
        <h3>Módulo no disponible</h3>
    </div>
}
else
{
    <section class="module-page">
        <div class="page-heading">
            <div>
                <div class="eyebrow">Gestión clínica</div>
                <h1>@Definition.Title</h1>
                <p>@Definition.Subtitle</p>
            </div>

            @if (_canCreate)
            {
                <button class="btn-clinic-primary" @onclick="OpenCreateAsync">
                    <AppIcon Name="plus" />
                    Nuevo @Definition.Singular
                </button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert-clinic @(_messageIsError ? "alert-error" : "alert-success")">
                <span>@_message</span>
                <button type="button" @onclick="ClearMessage">×</button>
            </div>
        }

        <div class="panel-card data-panel">
            <div class="table-toolbar">
                <div class="search-box">
                    <AppIcon Name="search" />

                    <input placeholder="Buscar en @Definition.Title.ToLowerInvariant()..."
                           value="@_search"
                           @oninput="SearchChanged" />
                </div>

                <div class="toolbar-actions">
                    <span class="record-count">
                        @FilteredRecords.Count registro@(FilteredRecords.Count == 1 ? "" : "s")
                    </span>

                    <button class="icon-button"
                            title="Actualizar"
                            @onclick="LoadAsync"
                            disabled="@_loading">
                        <AppIcon Name="refresh" />
                    </button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="table-loading">
                    <div class="spinner-clinic"></div>
                    <span>Cargando información...</span>
                </div>
            }
            else if (_records.Count == 0)
            {
                <div class="empty-state compact">
                    <AppIcon Name="@Definition.Icon" />
                    <h3>No hay registros todavía</h3>
                    <p>Crea el primer @Definition.Singular para comenzar.</p>
                </div>
            }
            else
            {
                <div class="table-responsive clinic-table-wrap">
                    <table class="clinic-table">
                        <thead>
                            <tr>
                                @foreach (var column in Definition.Columns)
                                {
                                    <th>@column.Label</th>
                                }

                                @if (CanShowDetails(Definition.Slug) || _canEdit || _canDelete)
                                {
                                    <th class="actions-column">
                                        Acciones
                                    </th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var record in PagedRecords)
                            {
                                <tr>
                                    @foreach (var column in Definition.Columns)
                                    {
                                        <td data-label="@column.Label">
                                            @if (column.Format is
                                                ColumnFormat.Status or
                                                ColumnFormat.Boolean)
                                            {
                                                <span class="status-pill @StatusClass(ApiClient.GetDisplayValue(record, column.Key))">
                                                    @FormatValue(record, column)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="cell-text">
                                                    @FormatValue(record, column)
                                                </span>
                                            }
                                        </td>
                                    }

                                    @if (CanShowDetails(Definition.Slug) || _canEdit || _canDelete)
                                    {
                                        <td class="row-actions"
                                            data-label="Acciones">

                                            @if (CanShowDetails(Definition.Slug))
                                            {
                                                <button class="table-action details"
                                                        title="Detalles"
                                                        @onclick="() => OpenDetails(record)">
                                                    <AppIcon Name="eye" />
                                                </button>
                                            }

                                            @if (_canEdit)
                                            {
                                                <button class="table-action edit"
                                                        title="Editar"
                                                        @onclick="() => OpenEditAsync(record)">
                                                    <AppIcon Name="edit" />
                                                </button>
                                            }

                                            @if (_canDelete)
                                            {
                                                <button class="table-action delete"
                                                        title="Eliminar"
                                                        @onclick="() => AskDelete(record)">
                                                    <AppIcon Name="trash" />
                                                </button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (TotalPages > 1)
                {
                    <div class="pagination-bar">
                        <span>
                            Página @_page de @TotalPages
                        </span>

                        <div>
                            <button class="page-button"
                                    disabled="@(_page <= 1)"
                                    @onclick="PreviousPage">
                                Anterior
                            </button>

                            <button class="page-button"
                                    disabled="@(_page >= TotalPages)"
                                    @onclick="NextPage">
                                Siguiente
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </section>
}

@if (_showDetails &&
     _detailRecord is { } detail &&
     Definition is not null)
{
    <div class="modal-backdrop-clinic"
         @onclick="CloseDetails">

        <div class="modal-card-clinic patient-details-card"
             @onclick:stopPropagation="true">

            <div class="modal-header-clinic">
                <div>
                    <div class="eyebrow">
                        Información detallada
                    </div>

                    <h2>
                        @GetDetailTitle(detail)
                    </h2>
                </div>

                <button class="icon-button"
                        @onclick="CloseDetails">
                    <AppIcon Name="close" />
                </button>
            </div>

            <div class="modal-body-clinic">

                <div class="patient-details-grid">

                    @foreach (var item in GetDetailItems())
                    {
                        <div class="patient-detail-item @(item.FullWidth ? "full-width" : "")">
                            <span>
                                @item.Label
                            </span>

                            <strong>
                                @if (item.Format == DetailFormat.Status)
                                {
                                    <span class="status-pill @StatusClass(ApiClient.GetDisplayValue(detail, item.Key))">
                                        @FormatDetailItemValue(
                                            detail,
                                            item)
                                    </span>
                                }
                                else
                                {
                                    @FormatDetailItemValue(
                                        detail,
                                        item)
                                }
                            </strong>
                        </div>
                    }

                    @if (Definition.Slug.Equals(
                        "medicamentos",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        var imagen =
                            ApiClient.GetDisplayValue(
                                detail,
                                "imagen");

                        <div class="patient-detail-item full-width">
                            <span>Imagen</span>

                            @if (!string.IsNullOrWhiteSpace(imagen) &&
                                 imagen != "—")
                            {
                                <div style="
                                    margin-top: 10px;
                                    width: 100%;
                                    display: flex;
                                    justify-content: center;
                                    align-items: center;">

                                    <img src="@imagen"
                                         alt="@ApiClient.GetDisplayValue(detail, "nombre")"
                                         style="
                                            max-width: 320px;
                                            max-height: 260px;
                                            width: auto;
                                            height: auto;
                                            object-fit: contain;
                                            border-radius: 12px;
                                            border: 1px solid rgba(0,0,0,.12);" />
                                </div>
                            }
                            else
                            {
                                <strong>
                                    Sin imagen registrada.
                                </strong>
                            }
                        </div>
                    }

                    @if (Definition.Slug.Equals(
                        "examenes",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        var tienePdf =
                            ApiClient.GetDisplayValue(
                                detail,
                                "tienePdf");

                        var nombrePdf =
                            ApiClient.GetDisplayValue(
                                detail,
                                "nombreArchivoPdf");

                        <div class="patient-detail-item full-width">
                            <span>Documento PDF</span>

                            @if (tienePdf.Equals(
                                    "True",
                                    StringComparison.OrdinalIgnoreCase) ||
                                 tienePdf.Equals(
                                    "Sí",
                                    StringComparison.OrdinalIgnoreCase))
                            {
                                <strong>
                                    @nombrePdf
                                </strong>

                                <div style="margin-top: 10px;">
                                    <button type="button"
                                            class="btn-clinic-primary"
                                            @onclick="() => OpenExamPdfAsync(detail)">
                                        Abrir PDF
                                    </button>
                                </div>
                            }
                            else
                            {
                                <strong>
                                    Sin PDF adjunto.
                                </strong>
                            }
                        </div>
                    }

                </div>

            </div>

            <div class="modal-footer-clinic">
                <button class="btn-clinic-primary"
                        @onclick="CloseDetails">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
}
@if (_showEditor && Definition is not null)
{
    <div class="modal-backdrop-clinic"
         @onclick="CloseEditor">

        <div class="modal-card-clinic"
             @onclick:stopPropagation="true">

            <div class="modal-header-clinic">
                <div>
                    <div class="eyebrow">
                        @(_editing
                            ? "Editar registro"
                            : "Nuevo registro")
                    </div>

                    <h2>
                        @(_editing
                            ? $"Editar {Definition.Singular}"
                            : $"Nuevo {Definition.Singular}")
                    </h2>
                </div>

                <button class="icon-button"
                        @onclick="CloseEditor">
                    <AppIcon Name="close" />
                </button>
            </div>

            <div class="modal-body-clinic">
                @if (!string.IsNullOrWhiteSpace(
                    _editorError))
                {
                    <div class="alert-clinic alert-error">
                        @_editorError
                    </div>
                }

                <div class="form-grid-clinic">
                    @foreach (var field in VisibleFields)
                    {
                        <div class="form-field @(field.Kind == FieldKind.TextArea ? "full-width" : "")">

                            @if (field.Kind ==
                                 FieldKind.Boolean)
                            {
                                <label class="switch-row">
                                    <span>
                                        <strong>
                                            @field.Label
                                        </strong>

                                        <small>
                                            Activa o desactiva esta opción.
                                        </small>
                                    </span>

                                    <input type="checkbox"
                                           checked="@GetBool(field.Key)"
                                           @onchange="e => BooleanChanged(field.Key, e)" />

                                    <span class="switch-ui"></span>
                                </label>
                            }
                            else
                            {
                                <label for="@field.Key">
                                    @field.Label

                                    @if (field.Required)
                                    {
                                        <span class="required-mark">
                                            *
                                        </span>
                                    }
                                </label>

                                @switch (field.Kind)
                                {
                                    case FieldKind.TextArea:
                                        <textarea id="@field.Key"
                                                  rows="4"
                                                  placeholder="@field.Placeholder"
                                                  value="@GetValue(field.Key)"
                                                  @oninput="e => TextChanged(field.Key, e)">
                                        </textarea>
                                        break;

                                    case FieldKind.Select:
                                        <select id="@field.Key"
                                                value="@GetValue(field.Key)"
                                                @onchange="e => SelectChangedAsync(field, e)">

                                            <option value="">
                                                Selecciona una opción
                                            </option>

                                            @foreach (var option in
                                                GetOptions(field.Key))
                                            {
                                                <option value="@option.Value">
                                                    @option.Text
                                                </option>
                                            }
                                        </select>
                                        break;

                                    case FieldKind.Password:
                                        <input id="@field.Key"
                                               type="password"
                                               autocomplete="new-password"
                                               placeholder="@field.Placeholder"
                                               value="@GetValue(field.Key)"
                                               @oninput="e => TextChanged(field.Key, e)" />
                                        break;

                                    case FieldKind.Integer:
                                        <input id="@field.Key"
                                               type="number"
                                               step="1"
                                               placeholder="@field.Placeholder"
                                               value="@GetValue(field.Key)"
                                               @oninput="e => TextChanged(field.Key, e)" />
                                        break;

                                    case FieldKind.Decimal:
                                        <input id="@field.Key"
                                               type="number"
                                               step="0.01"
                                               placeholder="@field.Placeholder"
                                               value="@GetValue(field.Key)"
                                               @oninput="e => TextChanged(field.Key, e)" />
                                        break;

                                    case FieldKind.Date:
                                        <input id="@field.Key"
                                               type="date"
                                               value="@GetValue(field.Key)"
                                               min="@GetDateTimeMinimum(field.Key)"
                                               @onchange="e => TextChanged(field.Key, e)" />
                                        break;

                                    case FieldKind.DateTime:
                                        <input id="@field.Key"
                                               type="datetime-local"
                                               value="@GetValue(field.Key)"
                                               min="@GetDateTimeMinimum(field.Key)"
                                               @onchange="e => TextChanged(field.Key, e)" />
                                        break;

                                    case FieldKind.Time:
                                        <input id="@field.Key"
                                               type="time"
                                               step="1"
                                               value="@GetValue(field.Key)"
                                               min="@GetDateTimeMinimum(field.Key)"
                                               @onchange="e => TextChanged(field.Key, e)" />
                                        break;

                                    default:
                                        <input id="@field.Key"
                                               type="text"
                                               placeholder="@field.Placeholder"
                                               value="@GetValue(field.Key)"
                                               @oninput="e => TextChanged(field.Key, e)"
                                               readonly="@(_editing && field.ReadOnlyOnEdit)" />
                                        break;
                                }
                            }
                        </div>
                    }

                    @if (Definition.Slug.Equals(
                        "examenes",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="form-field full-width">
                            <label>
                                PDF del resultado
                            </label>

                            <InputFile
                                OnChange="HandleExamPdfSelected"
                                accept=".pdf,application/pdf" />

                            @if (!string.IsNullOrWhiteSpace(
                                _examPdfName))
                            {
                                <small>
                                    Archivo seleccionado:
                                    @_examPdfName
                                </small>
                            }
                            else if (_editing &&
                                     _selected is { } examRecord)
                            {
                                var actual =
                                    ApiClient.GetDisplayValue(
                                        examRecord,
                                        "nombreArchivoPdf");

                                if (actual != "—")
                                {
                                    <small>
                                        PDF actual: @actual
                                    </small>
                                }
                            }

                            @if (!string.IsNullOrWhiteSpace(
                                _examPdfError))
                            {
                                <small class="text-danger">
                                    @_examPdfError
                                </small>
                            }
                        </div>
                    }

                    @if (Definition.Slug.Equals(
                            "consultas",
                            StringComparison.OrdinalIgnoreCase) &&
                        GetValue(
                            "lecturaResultadosExamenes")
                            .Equals(
                                "Sí",
                                StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="form-field full-width">
                            <label>
                                Exámenes realizados al paciente
                            </label>

                            @if (_readingExamsLoading)
                            {
                                <p>Cargando exámenes...</p>
                            }
                            else if (_readingExams.Count == 0)
                            {
                                <p>
                                    Este paciente no tiene exámenes registrados.
                                </p>
                            }
                            else
                            {
                                @foreach (var exam in _readingExams)
                                {
                                    <div class="panel-card"
                                         style="padding:12px; margin-bottom:10px;">

                                        <strong>
                                            @ApiClient.GetDisplayValue(
                                                exam,
                                                "nombreExamen")
                                        </strong>

                                        <div>
                                            Diagnóstico:
                                            @ApiClient.GetDisplayValue(
                                                exam,
                                                "diagnostico")
                                        </div>

                                        <div>
                                            Fecha:
                                            @ApiClient.GetDisplayValue(
                                                exam,
                                                "fechaExamen")
                                        </div>

                                        <div>
                                            Resultado:
                                            @ApiClient.GetDisplayValue(
                                                exam,
                                                "resultado")
                                        </div>

                                        @{
                                            var pdf =
                                                ApiClient.GetDisplayValue(
                                                    exam,
                                                    "nombreArchivoPdf");
                                        }

                                        @if (pdf != "—")
                                        {
                                            <div style="margin-top:8px;">
                                                <button type="button"
                                                        class="btn-clinic-ghost"
                                                        @onclick="() => OpenExamPdfAsync(exam)">
                                                    Ver PDF: @pdf
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                PDF: No adjunto
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="modal-footer-clinic">
                <button class="btn-clinic-ghost"
                        @onclick="CloseEditor"
                        disabled="@_saving">
                    Cancelar
                </button>

                <button class="btn-clinic-primary"
                        @onclick="SaveAsync"
                        disabled="@_saving">

                    @if (_saving)
                    {
                        <span class="mini-spinner"></span>
                    }

                    @(_editing
                        ? "Guardar cambios"
                        : "Crear registro")
                </button>
            </div>
        </div>
    </div>
}

@if (_showDelete && Definition is not null)
{
    <div class="modal-backdrop-clinic"
         @onclick="CancelDelete">

        <div class="confirm-card"
             @onclick:stopPropagation="true">

            <div class="danger-icon">
                <AppIcon Name="trash" />
            </div>

            <h3>
                Eliminar @Definition.Singular
            </h3>

            <p>
                Esta acción no se puede deshacer.
                El sistema respetará las restricciones
                de integridad definidas en la API.
            </p>

            <div class="confirm-actions">
                <button class="btn-clinic-ghost"
                        @onclick="CancelDelete"
                        disabled="@_saving">
                    Cancelar
                </button>

                <button class="btn-danger-clinic"
                        @onclick="DeleteAsync"
                        disabled="@_saving">
                    Eliminar
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public ModuleDefinition? Definition { get; set; }

    private readonly List<JsonElement> _records = [];

    private readonly Dictionary<string, string> _formValues =
        new(StringComparer.OrdinalIgnoreCase);

    private readonly Dictionary<string, List<SelectOption>> _options =
        new(StringComparer.OrdinalIgnoreCase);

    private bool _loading = true;
    private bool _saving;
    private bool _showEditor;
    private bool _showDelete;
    private bool _showDetails;
    private bool _editing;

    private bool _canCreate;
    private bool _canEdit;
    private bool _canDelete;

    private JsonElement? _selected;
    private JsonElement? _detailRecord;

    private string _search = string.Empty;
    private string? _message;
    private string? _editorError;

    private string _evolutionMinDateTime =
        string.Empty;
	private readonly List<JsonElement>
    	_readingExams = [];

	private bool _readingExamsLoading;

	private string? _examPdfBase64;
	private string? _examPdfName;
	private string? _examPdfError;

	private const long MaxPdfSize =
    	5 * 1024 * 1024;

    private bool _messageIsError;

    private int _page = 1;

    private const int PageSize = 10;

    private readonly SemaphoreSlim _loadLock =
        new(1, 1);

    private HubConnection? _habitacionesHub;

    protected override async Task OnParametersSetAsync()
    {
        _page = 1;

        await LoadPermissionsAsync();
        await ConfigurarSignalRAsync();
        await LoadAsync();
    }

    private List<JsonElement> FilteredRecords
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search) ||
                Definition is null)
            {
                return _records;
            }

            var term =
                _search.Trim();

            return _records
                .Where(r =>
                    Definition.Columns.Any(c =>
                        ApiClient
                            .GetDisplayValue(
                                r,
                                c.Key)
                            .Contains(
                                term,
                                StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

    private IEnumerable<JsonElement> PagedRecords =>
        FilteredRecords
            .Skip((_page - 1) * PageSize)
            .Take(PageSize);

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                FilteredRecords.Count /
                (double)PageSize));

    private IEnumerable<FieldDefinition> VisibleFields =>
        Definition?.Fields
            .Where(f =>
                _editing
                    ? !f.HiddenOnEdit
                    : !f.HiddenOnCreate)
        ?? [];

    private async Task LoadPermissionsAsync()
    {
        _canCreate = false;
        _canEdit = false;
        _canDelete = false;

        if (Definition is null)
        {
            return;
        }

        var modulos =
            await Api.GetCollectionAsync(
                "api/Modulos/mis-modulos");

        var nombreModulo =
            Definition.Endpoint
                .TrimEnd('/')
                .Split('/')
                .Last();

        var modulo =
            modulos.FirstOrDefault(m =>
                ApiClient
                    .GetDisplayValue(
                        m,
                        "nombre")
                    .Equals(
                        nombreModulo,
                        StringComparison.OrdinalIgnoreCase));

        if (modulo.ValueKind !=
                JsonValueKind.Object ||
            !ApiClient.TryGetProperty(
                modulo,
                "operaciones",
                out var operaciones) ||
            operaciones.ValueKind !=
                JsonValueKind.Array)
        {
            return;
        }

        var permisos =
            operaciones
                .EnumerateArray()
                .Where(o =>
                    o.ValueKind ==
                    JsonValueKind.String)
                .Select(o =>
                    o.GetString()
                    ?? string.Empty)
                .ToHashSet(
                    StringComparer.OrdinalIgnoreCase);

        _canCreate =
            Definition.CanCreate &&
            permisos.Contains("Crear");

        _canEdit =
            Definition.CanEdit &&
            permisos.Contains("Modificar");

        _canDelete =
            Definition.CanDelete &&
            permisos.Contains("Eliminar");
    }

    private async Task LoadAsync()
    {
        if (Definition is null)
        {
            return;
        }

        await _loadLock.WaitAsync();

        try
        {
            _loading = true;

            var registros =
                await Api.GetCollectionAsync(
                    Definition.Endpoint);

            _records.Clear();
            _records.AddRange(registros);

            if (_page > TotalPages)
            {
                _page = TotalPages;
            }
        }
        finally
        {
            _loading = false;
            _loadLock.Release();
        }
    }

    private async Task ConfigurarSignalRAsync()
    {
        var esModuloHabitaciones =
            Definition?.Slug.Equals(
                "habitaciones",
                StringComparison.OrdinalIgnoreCase)
            == true;

        if (!esModuloHabitaciones)
        {
            await DetenerSignalRAsync();
            return;
        }

        if (_habitacionesHub is not null)
        {
            return;
        }

        var apiBaseUrl =
            Configuration["ApiBaseUrl"]
            ?? "http://localhost:5002/";

        apiBaseUrl =
            apiBaseUrl.TrimEnd('/');

        _habitacionesHub =
            new HubConnectionBuilder()
                .WithUrl(
                    $"{apiBaseUrl}/hubs/habitaciones",
                    options =>
                    {
                        options.AccessTokenProvider =
                            async () =>
                                await TokenStorage
                                    .GetTokenAsync();
                    })
                .WithAutomaticReconnect()
                .Build();

        _habitacionesHub.On(
            "HabitacionesActualizadas",
            () =>
                InvokeAsync(
                    async () =>
                    {
                        await LoadAsync();
                        StateHasChanged();
                    }));

        try
        {
            await _habitacionesHub.StartAsync();
        }
        catch
        {
            await _habitacionesHub.DisposeAsync();
            _habitacionesHub = null;
        }
    }

    private async Task DetenerSignalRAsync()
    {
        if (_habitacionesHub is null)
        {
            return;
        }

        await _habitacionesHub.DisposeAsync();

        _habitacionesHub = null;
    }

    public async ValueTask DisposeAsync()
    {
        await DetenerSignalRAsync();
    }

    private void SearchChanged(
        ChangeEventArgs e)
    {
        _search =
            e.Value?.ToString()
            ?? string.Empty;

        _page = 1;
    }

    private async Task OpenCreateAsync()
    {
        _editing = false;
        _selected = null;
        _formValues.Clear();
        _options.Clear();
        _editorError = null;

        _evolutionMinDateTime =
            string.Empty;
	_readingExams.Clear();

	_examPdfBase64 = null;
	_examPdfName = null;
	_examPdfError = null;

        if (Definition is null)
        {
            return;
        }

        foreach (var field in Definition.Fields)
        {
            var value =
                field.DefaultValue
                ?? string.Empty;

