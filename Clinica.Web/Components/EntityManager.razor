    private async Task LoadOptionsAsync()
    {
        if (Definition is null)
        {
            return;
        }

        foreach (var field in Definition.Fields
            .Where(f =>
                f.Kind == FieldKind.Select &&
                !string.IsNullOrWhiteSpace(
                    f.OptionsEndpoint)))
        {
            var slug =
                Definition.Slug.ToLowerInvariant();

            if (field.Key.Equals(
                    "idConsulta",
                    StringComparison.OrdinalIgnoreCase) &&
                (
                    slug == "diagnosticos" ||
                    slug == "recetas" ||
                    slug == "tratamientos"
                ))
            {
                await LoadPatientConsultasAsync(
                    GetValue("idPaciente"));

                continue;
            }

            if (field.Key.Equals(
                    "idDiagnostico",
                    StringComparison.OrdinalIgnoreCase) &&
                (
                    slug == "examenes" ||
                    slug == "asignaciones-habitacion"
                ))
            {
                await LoadPatientDiagnosticosAsync(
                    GetValue("idPaciente"));

                continue;
            }

            if (slug == "evoluciones" &&
                (
                    field.Key.Equals(
                        "idReceta",
                        StringComparison.OrdinalIgnoreCase) ||
                    field.Key.Equals(
                        "idTratamiento",
                        StringComparison.OrdinalIgnoreCase)
                ))
            {
                if (!_options.ContainsKey("idReceta") ||
                    !_options.ContainsKey("idTratamiento"))
                {
                    await LoadPatientEvolutionSourcesAsync(
                        GetValue("idPaciente"));
                }

                continue;
            }

            if (_options.ContainsKey(field.Key))
            {
                continue;
            }

            var options =
                new List<SelectOption>();

            if (field.OptionsEndpoint!
                .StartsWith(
                    "$static:",
                    StringComparison.Ordinal))
            {
                var raw =
                    field.OptionsEndpoint[8..];

                options.AddRange(
                    raw.Split(
                            '|',
                            StringSplitOptions.RemoveEmptyEntries)
                        .Select(x =>
                            new SelectOption
                            {
                                Value = x,
                                Text = x
                            }));
            }
            else
            {
                var rows =
                    await Api.GetCollectionAsync(
                        field.OptionsEndpoint);

                foreach (var row in rows)
                {
                    var value =
                        ApiClient.GetDisplayValue(
                            row,
                            field.OptionValueKey ?? "id");

                    var text =
                        ApiClient.GetDisplayValue(
                            row,
                            field.OptionTextKey ?? "nombre");

                    if (!string.IsNullOrWhiteSpace(
                        field.OptionTextKey2))
                    {
                        var second =
                            ApiClient.GetDisplayValue(
                                row,
                                field.OptionTextKey2);

                        if (second != "—")
                        {
                            text =
                                $"{text} {second}";
                        }
                    }

                    options.Add(
                        new SelectOption
                        {
                            Value = value,
                            Text = text.Trim()
                        });
                }
            }

            _options[field.Key] =
                options;
        }
    }
