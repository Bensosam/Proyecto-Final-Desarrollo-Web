private async Task HandleExamPdfSelected(
    InputFileChangeEventArgs e)
{
    _examPdfError = null;
    _examPdfBase64 = null;
    _examPdfName = null;

    var file = e.File;

    if (!file.Name.EndsWith(
            ".pdf",
            StringComparison.OrdinalIgnoreCase))
    {
        _examPdfError =
            "Debe seleccionar un archivo PDF.";

        return;
    }

    if (file.Size > MaxPdfSize)
    {
        _examPdfError =
            "El PDF no puede superar los 5 MB.";

        return;
    }

    try
    {
        using var stream =
            file.OpenReadStream(
                MaxPdfSize);

        using var memory =
            new MemoryStream();

        await stream.CopyToAsync(
            memory);

        var bytes =
            memory.ToArray();

        if (bytes.Length < 4 ||
            bytes[0] != 0x25 ||
            bytes[1] != 0x50 ||
            bytes[2] != 0x44 ||
            bytes[3] != 0x46)
        {
            _examPdfError =
                "El archivo no es un PDF válido.";

            return;
        }

        _examPdfBase64 =
            Convert.ToBase64String(
                bytes);

        _examPdfName =
            file.Name;
    }
    catch (Exception ex)
    {
        _examPdfError =
            ex.Message;
    }
}

private async Task OpenExamPdfAsync(
    JsonElement examen)
{
    var id =
        ApiClient.GetDisplayValue(
            examen,
            "idExamen");

    var response =
        await Api.GetAsync(
            $"api/Examenes/{id}/pdf");

    if (!response.IsSuccess ||
        response.Data is null)
    {
        _editorError =
            response.Message ??
            "No fue posible abrir el PDF.";

        return;
    }

    var data =
        response.Data.Value;

    var base64 =
        ApiClient.GetDisplayValue(
            data,
            "contenidoBase64");

    var nombre =
        ApiClient.GetDisplayValue(
            data,
            "nombreArchivo");

    await JS.InvokeVoidAsync(
        "openExamPdf",
        base64,
        nombre);
}

