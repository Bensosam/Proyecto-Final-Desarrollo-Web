        _egresoHasta =
            null;
    }

    private static string GetString(
        JsonElement element,
        string key)
    {
        if (!ApiClient.TryGetProperty(
                element,
                key,
                out var value))
        {
            return string.Empty;
        }

        if (value.ValueKind is
            JsonValueKind.Null or
            JsonValueKind.Undefined)
        {
            return string.Empty;
        }

        return value.ToString();
    }

    private static int GetInt(
        JsonElement element,
        string key)
    {
        if (!ApiClient.TryGetProperty(
                element,
                key,
                out var value))
        {
            return 0;
        }

        if (value.ValueKind ==
                JsonValueKind.Number &&
            value.TryGetInt32(
                out var numero))
        {
            return numero;
        }

        return int.TryParse(
            value.ToString(),
            out var resultado)
                ? resultado
                : 0;
    }

    private static bool GetBool(
        JsonElement element,
        string key)
    {
        if (!ApiClient.TryGetProperty(
                element,
                key,
                out var value))
        {
            return false;
        }

        if (value.ValueKind ==
            JsonValueKind.True)
        {
            return true;
        }

        if (value.ValueKind ==
            JsonValueKind.False)
        {
            return false;
        }

        return bool.TryParse(
            value.ToString(),
            out var resultado) &&
            resultado;
    }

    private static DateTime GetDate(
        JsonElement element,
        string key)
    {
        var texto =
            GetString(
                element,
                key);

        return DateTime.TryParse(
            texto,
            out var fecha)
                ? fecha
                : default;
    }

    private static DateTime? GetNullableDate(
        JsonElement element,
        string key)
    {
        if (!ApiClient.TryGetProperty(
                element,
                key,
                out var value))
        {
            return null;
        }

        if (value.ValueKind is
            JsonValueKind.Null or
            JsonValueKind.Undefined)
        {
            return null;
        }

        return DateTime.TryParse(
            value.ToString(),
            out var fecha)
                ? fecha
                : null;
    }

    private static decimal GetDecimal(
        JsonElement element,
        string key)
    {
        return ApiClient.GetDecimal(
            element,
            key);
    }

