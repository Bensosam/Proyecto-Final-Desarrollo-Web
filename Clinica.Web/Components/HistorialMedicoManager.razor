    private string E(
        string key,
        bool emptyInsteadOfDash = false)
    {
        if (_historial is not { } root ||
            !ApiClient.TryGetProperty(
                root,
                "entrevistaInicial",
                out var entrevista))
        {
            return emptyInsteadOfDash
                ? string.Empty
                : "—";
        }

        var value =
            V(
