        }

        return value;
    }

    private static string V(
        JsonElement element,
        string key) =>
        ApiClient.GetDisplayValue(
            element,
            key);

    private static bool B(
        JsonElement element,
        string key)
    {
        if (!ApiClient.TryGetProperty(
                element,
                key,
                out var value))
        {
            return false;
        }

        return value.ValueKind ==
            JsonValueKind.True;
    }

    private static string D(
        JsonElement element,
        string key)
    {
        var raw =
            V(
                element,
                key);

        if (raw == "—")
        {
            return raw;
        }

        return DateTime.TryParse(
            raw,
            out var fecha)
            ? fecha.ToString(
                "dd/MM/yyyy")
            : raw;
    }

    private static string DT(
        JsonElement element,
        string key)
    {
        var raw =
            V(
                element,
                key);

        if (raw == "—")
        {
            return raw;
        }

        return DateTime.TryParse(
            raw,
            out var fecha)
            ? fecha.ToString(
                "dd/MM/yyyy HH:mm")
            : raw;
    }

    private static string NullableId(
        JsonElement element,
        string key)
    {
        var value =
            V(
                element,
                key);

        return value == "—"
            ? "—"
            : $"#{value}";
    }

    private static RenderFragment Info(
        string label,
        string value) =>
        builder =>
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "hm-info-item");

            builder.OpenElement(2, "span");
            builder.AddAttribute(
                3,
                "style",
                "margin-right: 16px;");
            builder.AddContent(4, label);
            builder.CloseElement();

            builder.OpenElement(5, "strong");
            builder.AddContent(
                6,
                string.IsNullOrWhiteSpace(value) ||
                value == "—"
                    ? "No registrado"
                    : value);
            builder.CloseElement();

            builder.CloseElement();
        };
