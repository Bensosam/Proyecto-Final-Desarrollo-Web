@implements IAsyncDisposable
@inject ApiClient Api

<div class="sidebar-brand">
    <div class="brand-mark">+</div>

    <div>
        <strong>Clínica</strong>
        <span>Gestión Médica</span>
    </div>
</div>

<nav class="sidebar-nav">
    <NavLink href="/"
             Match="NavLinkMatch.All"
             class="nav-entry"
             @onclick="NotifyNavigate">
        <AppIcon Name="home" />
        <span>Dashboard</span>
    </NavLink>

    @if (_loading)
    {
        <div class="nav-section-title">
            Cargando permisos...
        </div>
    }
    else
    {
        @foreach (var grupo in _grupos)
        {
            var visibles = grupo.Items
                .Where(PuedeVer)
                .ToList();

            if (visibles.Count > 0)
            {
                <div class="nav-section-title">
                    @grupo.Nombre
                </div>

                @foreach (var item in visibles)
                {
                    <NavLink href="@($"/modulo/{item.Slug}")"
                             class="nav-entry"
                             @onclick="NotifyNavigate">
                        <AppIcon Name="@item.Icon" />
                        <span>@item.Texto</span>
                    </NavLink>
                }
            }
        }
    }
</nav>

<div class="sidebar-footer">
    <span class="status-dot"></span>

    <div>
        <strong>Sistema en línea</strong>
        <small>
            ClinicaFinal · .NET 10
        </small>
    </div>
</div>

