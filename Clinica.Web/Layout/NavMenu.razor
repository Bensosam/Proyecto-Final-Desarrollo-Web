    protected override async Task OnInitializedAsync()
    {
        await CargarPermisosAsync();

        _loading = false;

        _refreshTimer =
            new PeriodicTimer(
                TimeSpan.FromSeconds(30));

        _ = ActualizarPermisosPeriodicamenteAsync();
    }

    private bool PuedeVer(
        MenuItem item)
    {
        return _modulosPermitidos.Contains(
            item.Modulo);
    }

    private async Task CargarPermisosAsync()
    {
        try
        {
            var datos =
                await Api.GetCollectionAsync(
                    "api/Modulos/mis-modulos");

            var nuevosPermisos =
                new HashSet<string>(
                    StringComparer.OrdinalIgnoreCase);

            foreach (var modulo in datos)
            {
                var nombre =
                    ApiClient.GetDisplayValue(
                        modulo,
                        "nombre");

                if (!string.IsNullOrWhiteSpace(
                        nombre) &&
                    nombre != "—")
                {
                    nuevosPermisos.Add(
                        nombre);
                }
            }

            _modulosPermitidos =
                nuevosPermisos;
        }
        catch
        {
            // Si ocurre un fallo temporal,
            // conservamos los permisos que ya estaban cargados.
        }
    }

    private async Task
        ActualizarPermisosPeriodicamenteAsync()
    {
        if (_refreshTimer is null)
        {
            return;
        }

        try
        {
            while (await _refreshTimer
                .WaitForNextTickAsync(
                    _refreshCancellation.Token))
            {
                await InvokeAsync(
                    async () =>
                    {
                        await CargarPermisosAsync();
                        StateHasChanged();
                    });
            }
        }
        catch (OperationCanceledException)
        {
            // El componente fue destruido.
        }
    }

    private async Task NotifyNavigate()
    {
        // También actualizamos al usar el menú,
        // sin esperar los 30 segundos.
        await CargarPermisosAsync();

        await OnNavigate.InvokeAsync();
    }

    public ValueTask DisposeAsync()
    {
        _refreshCancellation.Cancel();

        _refreshTimer?.Dispose();

        _refreshCancellation.Dispose();

        return ValueTask.CompletedTask;
    }

    private sealed record MenuGroup(
        string Nombre,
        List<MenuItem> Items);

    private sealed record MenuItem(
        string Modulo,
        string Slug,
        string Icon,
        string Texto);
}